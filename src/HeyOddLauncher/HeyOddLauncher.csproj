<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>HeyOdd Minecraft</AssemblyName>
    <RootNamespace>HeyOddLauncher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\HeyOddLauncher.Core\HeyOddLauncher.Core.csproj" />
    <PackageReference Include="CmlLib.Core" Version="4.0.6" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.3.1" />
    <PackageReference Include="CmlLib.Core.Installer.NeoForge" Version="4.0.1" />
    <PackageReference Include="XboxAuthNet.Game.Msal" Version="0.1.3" />
  </ItemGroup>
  <ItemGroup>
    <None Update="launcher-settings.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <Resource Include="Assets\yeongmu-yedaeum-bg.png" />
    <EmbeddedResource Include="Pack\base-pack.zip" LogicalName="HeyOddLauncher.Pack.base-pack.zip" />
    <EmbeddedResource Include="Pack\pack-manifest.json" LogicalName="HeyOddLauncher.Pack.pack-manifest.json" />
  </ItemGroup>
</Project>
